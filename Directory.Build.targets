<Project>
  <!-- After project imports: keep vendored Markdown.Avalonia nullable noise as warnings, not errors. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('Markdown.Avalonia'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <MSBuildWarningsAsErrors></MSBuildWarningsAsErrors>
  </PropertyGroup>
</Project>