@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject McpServerManager.UI.Core.Services.IUiDispatcherService UiDispatcher
@inject IJSRuntime JsRuntime
@inject WorkspaceAutoSelector WorkspaceAutoSelector
@inject BackendConnectionMonitor ConnectionMonitor
@inject WebVoiceConversationViewModel AgentChatViewModel
@inject WorkspaceContextViewModel WorkspaceContext
@implements IDisposable

<div class="d-flex flex-column" style="height: 100vh; min-height: 0" data-app-shell tabindex="-1" @onkeydown="HandleShellKeyDown">
    <header class="Header app-header-sticky">
        <div class="Header-item">
            <a href="/" class="Header-link f4 d-flex flex-items-center">
                <OcticonIcon Name="server" Class="mr-2" />
                <span class="text-bold">McpServer</span>
            </a>
        </div>
        <div class="Header-item">
            <button type="button"
                    class="btn btn-sm app-header-icon-button"
                    id="app-back-button"
                    aria-label="Back"
                    title="Back"
                    @onclick="GoBackAsync">
                <OcticonIcon Name="arrow-left" />
            </button>
        </div>
        <div class="Header-item">
            <nav class="header-nav" aria-label="Main navigation">
                <NavMenu />
            </nav>
        </div>
        <div class="Header-item app-workspace-control">
            <button type="button"
                    class="btn btn-sm"
                    id="workspace-picker-toggle"
                    aria-expanded="@_isWorkspacePickerOpen"
                    aria-controls="workspace-picker-panel"
                    title="Workspace (Ctrl+W)"
                    @onclick="ToggleWorkspacePicker">
                <OcticonIcon Name="repo" Class="mr-1" />
                Workspace
                <span class="text-small color-fg-muted ml-1">Ctrl+W</span>
            </button>
            @if (_isWorkspacePickerOpen)
            {
                <div class="Box p-3 app-workspace-picker-panel" id="workspace-picker-panel">
                    <WorkspacePicker Label="Workspace" IncludeDefaultOption="false" SelectedWorkspaceChanged="OnWorkspaceSelectedAsync" />
                </div>
            }
        </div>
        <div class="Header-item Header-item--full"></div>
        <div class="Header-item">
            @if (!_isConnected)
            {
                <span class="Label Label--danger mr-2" title="@_lastError">
                    <OcticonIcon Name="alert" Class="mr-1" />Disconnected
                </span>
            }
        </div>
        <div class="Header-item">
            <button type="button"
                    class="btn btn-sm"
                    id="agent-chat-launch"
                    aria-controls="agent-chat-flyout"
                    aria-expanded="@_isAgentChatOpen"
                    @onclick="ToggleAgentChat">
                Agent Chat
            </button>
        </div>
        <div class="Header-item">
            <AuthorizeView>
                <Authorized>
                    <span class="color-fg-on-emphasis mr-2">@context.User.Identity?.Name</span>
                    <a class="Header-link" href="/logout">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a class="Header-link" href="/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    @if (!_isConnected)
    {
        <div class="flash flash-error" role="alert">
            <OcticonIcon Name="alert" Class="mr-2" />
            <strong>Backend unavailable</strong> — Cannot reach the MCP server at the configured address. Retrying automatically&hellip;
            @if (!string.IsNullOrWhiteSpace(_lastError))
            {
                <span class="text-small ml-2">(@_lastError)</span>
            }
        </div>
    }

    <div class="app-shell flex-1 @(_isAgentChatOpen && _isAgentChatInline ? "app-shell--with-inline-chat" : null)">
        <main class="app-content flex-1" data-workspace-version="@_workspaceRenderKey" @key="_workspaceRenderKey">
            @Body
        </main>

        <AgentChatFlyout ViewModel="AgentChatViewModel"
                         IsOpen="@_isAgentChatOpen"
                         IsInline="@_isAgentChatInline"
                         OnClose="CloseAgentChatAsync"
                         OnInlineModeChanged="SetAgentChatInlineModeAsync" />
    </div>
</div>

@code {
    private bool _isConnected = true;
    private string? _lastError;
    private bool _isAgentChatOpen;
    private bool _isAgentChatInline;
    private bool _isWorkspacePickerOpen;
    private long _workspaceRenderKey;
    private DotNetObjectReference<MainLayout>? _dotNetReference;

    protected override async Task OnInitializedAsync()
    {
        ConnectionMonitor.PropertyChanged += OnConnectionChanged;
        WorkspaceContext.PropertyChanged += OnWorkspaceContextChanged;
        ConnectionMonitor.Start();
        await WorkspaceAutoSelector.EnsureWorkspaceSelectedAsync().ConfigureAwait(true);
        _workspaceRenderKey = WorkspaceContext.ChangeVersion;
        _isConnected = ConnectionMonitor.IsConnected;
        _lastError = ConnectionMonitor.LastError;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("mcpServerAppShell.registerWorkspaceShortcut", _dotNetReference).ConfigureAwait(true);
        }
    }

    private void OnConnectionChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(BackendConnectionMonitor.IsConnected)
            or nameof(BackendConnectionMonitor.LastError))
        {
            _isConnected = ConnectionMonitor.IsConnected;
            _lastError = ConnectionMonitor.LastError;
            _ = RefreshUiAsync();
        }
    }

    private void OnWorkspaceContextChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(WorkspaceContextViewModel.ChangeVersion))
        {
            _workspaceRenderKey = WorkspaceContext.ChangeVersion;
            _ = RefreshUiAsync();
        }
    }

    private Task RefreshUiAsync()
        => UiDispatcher.InvokeAsync(() =>
        {
            StateHasChanged();
            return Task.CompletedTask;
        });

    private void ToggleAgentChat()
    {
        _isAgentChatOpen = !_isAgentChatOpen;
    }

    private void ToggleWorkspacePicker()
    {
        _isWorkspacePickerOpen = !_isWorkspacePickerOpen;
    }

    private Task OnWorkspaceSelectedAsync(string? _)
    {
        _isWorkspacePickerOpen = false;
        return RefreshUiAsync();
    }

    private async Task GoBackAsync()
    {
        await JsRuntime.InvokeVoidAsync("mcpServerAppShell.goBack").ConfigureAwait(true);
    }

    private Task HandleShellKeyDown(KeyboardEventArgs args)
    {
        if (args.CtrlKey
            && !args.ShiftKey
            && !args.AltKey
            && string.Equals(args.Key, "w", StringComparison.OrdinalIgnoreCase))
        {
            _isWorkspacePickerOpen = true;
            return RefreshUiAsync();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OpenWorkspacePickerFromShortcut()
    {
        _isWorkspacePickerOpen = true;
        return RefreshUiAsync();
    }

    private Task CloseAgentChatAsync()
    {
        _isAgentChatOpen = false;
        return Task.CompletedTask;
    }

    private Task SetAgentChatInlineModeAsync(bool isInline)
    {
        _isAgentChatInline = isInline;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ConnectionMonitor.PropertyChanged -= OnConnectionChanged;
        WorkspaceContext.PropertyChanged -= OnWorkspaceContextChanged;
        _ = JsRuntime.InvokeVoidAsync("mcpServerAppShell.unregisterWorkspaceShortcut");
        _dotNetReference?.Dispose();
    }
}
