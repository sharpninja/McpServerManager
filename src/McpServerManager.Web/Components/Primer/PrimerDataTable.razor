@typeparam TGridItem
@attribute [CascadingTypeParameter(nameof(TGridItem))]

@if (this.Items is { Count: > 0 })
{
    <QuickGrid TGridItem="TGridItem"
               Items="@this.QueryableItems"
               Class="@this.CssClass"
               RowClass="@this.RowClass"
               @attributes="this.AdditionalAttributes">
        @this.ChildContent
    </QuickGrid>
}
else if (this.EmptyContent is not null)
{
    <div class="@this.EmptyClass">
        @this.EmptyContent
    </div>
}
else
{
    <div class="@this.EmptyClass">No data available.</div>
}

@code {
    [Parameter] public IReadOnlyList<TGridItem>? Items { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? EmptyContent { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>Optional callback to compute a CSS class for each row's <c>&lt;tr&gt;</c> element.</summary>
    [Parameter] public Func<TGridItem, string?>? RowClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[] { "Table", this.Class }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private string EmptyClass => string.Join(' ', new[] { "Table", "primer-quickgrid-empty", this.Class }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private IQueryable<TGridItem> QueryableItems => (this.Items ?? Array.Empty<TGridItem>()).AsQueryable();
}
