@using System.Reflection
@using McpServerManager.UI.Core.Services
@using McpServerManager.Web
@using Microsoft.Extensions.Logging
@inject WorkspaceAutoSelector WorkspaceAutoSelector
@inject ILogger<HybridRoot> Logger

<PageTitle>@AppTitle.Build("McpServer Web", typeof(HybridRoot).Assembly)</PageTitle>

@if (_workspaceReady)
{
    <Routes AdditionalAssemblies="AdditionalAssemblies" />
}
else
{
    <div class="hybrid-splash" role="status" aria-live="polite">
        <div class="hybrid-splash__panel">
            <div class="hybrid-splash__mark" aria-hidden="true">M</div>
            <div>
                <h1 class="hybrid-splash__title">McpServer</h1>
                <p class="hybrid-splash__status">Loading workspace...</p>
            </div>
        </div>
    </div>
}

@code {
    private static readonly Assembly[] AdditionalAssemblies = [typeof(HybridRoot).Assembly];

    private bool _workspaceReady;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await WorkspaceAutoSelector.EnsureWorkspaceSelectedAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Hybrid workspace auto-selection failed during startup.");
        }
        finally
        {
            _workspaceReady = true;
        }
    }
}
